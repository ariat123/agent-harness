# Copy this file to `.env` and fill in your own values.

# RapidAPI — subscribe to "Maps Data" by alexanderxbx at rapidapi.com
RAPIDAPI_KEY=

# Firecrawl — get an API key at firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_TIER=free

# Tunables
MIN_REVIEWS_FOR_ENRICHMENT=10
MAX_PAGES_PER_LEAD=2
ENRICH_ABOUT_PAGE=true
AUTO_BLOCK_CHAIN_LOCATION_THRESHOLD=20
